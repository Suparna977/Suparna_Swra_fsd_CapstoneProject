# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Where the database lives. Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/skill-gap-analyzer
# MongoDB Atlas (free cloud database) looks like:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skill-gap-analyzer?retryWrites=true&w=majority

# Any long random text. It signs the login tokens.
JWT_SECRET=change-this-to-a-long-random-text

PORT=5000
